@page "/simple-picker"
@rendermode InteractiveServer

<PageTitle>Simple Country Picker View</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3 rounded-top-3">
                    <h4 class="mb-0 text-center fw-semibold">Geography Selector</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        This view references <strong>CountryPicker.Blazor v1.0.0</strong> via a PackageReference to showcase a clean production-ready layout.
                    </p>

                    <!-- Country Picker -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary mb-2 d-flex align-items-center">
                            <span class="me-2">🌍</span> Select Country
                        </label>
                        <CountryPicker 
                            @bind-Value="SelectedCountry"
                            FavoriteCountries='new[] { "US", "GB", "GR", "CA", "AU" }'
                            ShowPhoneCode="true"
                            ShowSearch="true"
                            Placeholder="Search country name or code..."
                            ButtonPlaceholder="Choose a country..." />
                    </div>

                    <!-- State Picker -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary mb-2 d-flex align-items-center">
                            <span class="me-2">🗺️</span> Select State / Province
                        </label>
                        <StatePicker 
                            @bind-Value="SelectedState"
                            CountryCode="@SelectedCountry?.CountryCode"
                            ShowSearch="true"
                            Placeholder="Search state..."
                            ButtonPlaceholder="Choose a state..." />
                    </div>

                    <!-- City Picker -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary mb-2 d-flex align-items-center">
                            <span class="me-2">🏙️</span> Select City
                        </label>
                        <CityPicker 
                            @bind-Value="SelectedCity"
                            CountryCode="@SelectedCountry?.CountryCode"
                            StateId="@SelectedState?.Id"
                            ShowSearch="true"
                            Placeholder="Search city..."
                            ButtonPlaceholder="Choose a city..." />
                    </div>

                    <!-- Selected Values Display Card -->
                    @if (SelectedCountry != null)
                    {
                        <div class="card bg-light border-0 rounded-3 mt-4 animate-fade-in">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-primary mb-3">Active Selection Inspection</h6>
                                <div class="row g-2 font-monospace small">
                                    <div class="col-6 text-muted">Country Code:</div>
                                    <div class="col-6 fw-bold">@SelectedCountry.CountryCode</div>

                                    <div class="col-6 text-muted">Phone Dial Code:</div>
                                    <div class="col-6 fw-bold">+@SelectedCountry.PhoneCode</div>

                                    <div class="col-6 text-muted">Flag Emoji:</div>
                                    <div class="col-6 fs-5">@SelectedCountry.FlagEmoji</div>

                                    @if (SelectedState != null)
                                    {
                                        <div class="col-12"><hr class="my-2 text-muted" /></div>
                                        <div class="col-6 text-muted">State Name:</div>
                                        <div class="col-6 fw-bold">@SelectedState.Name</div>
                                        <div class="col-6 text-muted">State ID:</div>
                                        <div class="col-6 fw-bold">@SelectedState.Id</div>
                                    }

                                    @if (SelectedCity != null)
                                    {
                                        <div class="col-12"><hr class="my-2 text-muted" /></div>
                                        <div class="col-6 text-muted">City Name:</div>
                                        <div class="col-6 fw-bold">@SelectedCity.Name</div>
                                        <div class="col-6 text-muted">City ID:</div>
                                        <div class="col-6 fw-bold">@SelectedCity.Id</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private Country? SelectedCountry { get; set; }
    private State? SelectedState { get; set; }
    private City? SelectedCity { get; set; }
}
